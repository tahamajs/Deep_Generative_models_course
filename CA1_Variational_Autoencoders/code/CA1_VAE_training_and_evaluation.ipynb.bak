        "with torch.no_grad():\n",
        "    for images, labels in validation_data_loader:\n",
        "        images = images.to(device)\n",
        "        reconstructed, _, _ = vae_model(images)\n",
        "\n",
        "        for i, label in enumerate(labels):\n",
        "            mse = nn.functional.mse_loss(\n",
        "                reconstructed[i:i+1].cpu(),\n",
        "                images[i:i+1].cpu(),\n",
        "                reduction='mean'\n",
        "            ).item()\n",
