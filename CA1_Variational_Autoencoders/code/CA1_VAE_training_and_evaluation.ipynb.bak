            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "\n",
        "fig, axes = plt.subplots(2, 2, figsize=(14, 12))\n",
        "\n",
        "all_latents = np.vstack([smile_latents, nonsmile_latents])\n",
        "all_labels = np.array([0]*len(smile_latents) + [1]*len(nonsmile_latents))\n",
        "\n",
        "pca_2d = PCA(n_components=2)\n",
        "latent_pca = pca_2d.fit_transform(all_latents)\n",
        "\n",
        "scatter1 = axes[0, 0].scatter(latent_pca[all_labels == 0, 0], latent_pca[all_labels == 0, 1],\n",
        "                              c='blue', alpha=0.6, s=30, label='Smile')\n",
        "scatter2 = axes[0, 0].scatter(latent_pca[all_labels == 1, 0], latent_pca[all_labels == 1, 1],\n",
        "                              c='orange', alpha=0.6, s=30, label='Non-Smile')\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 34,
      "metadata": {
        "id": "y69RzH3H3927"
      },
      "outputs": [],
      "source": [
