      "source": [
        "num_epochs = 1000\n",
        "initial_learning_rate = 0.0005\n",
        "\n",
        "vae_model = VariationalAutoencoder(32).to(device)\n",
        "optimizer = torch.optim.Adam(vae_model.parameters(), lr=initial_learning_rate)\n",
        "\n",
        "train_total_losses = []\n",
        "validation_losses = []\n",
        "train_reconstruction_losses = []\n",
        "train_kl_divergence_losses = []\n",
        "\n"
      ]
    },
